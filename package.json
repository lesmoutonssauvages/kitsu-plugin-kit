{
  "name": "@lesmoutonssauvages/kitsu-plugin-kit",
  "version": "0.0.5",
  "type": "module",
  "description": "Authoring kit and Kitsu host runtime for injected frontend plugins (routes, Vuex, UI slots, provide/inject providers).",
  "repository": {
    "type": "git",
    "url": "https://github.com/lesmoutonssauvages/kitsu-plugin-kit.git"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js",
      "default": "./dist/vite/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js",
      "default": "./dist/host/index.js"
    },
    "./host/vite": {
      "types": "./dist/host/vite.d.ts",
      "import": "./dist/host/vite.js",
      "default": "./dist/host/vite.js"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.node.json",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly",
    "watch": "vite build --watch",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,vue}\"",
    "test": "npm run type-check",
    "smoke": "node --input-type=module -e \"await import('./dist/index.js'); await import('./dist/vite/index.js'); await import('./dist/host/index.js'); await import('./dist/host/vite.js')\"",
    "prepare": "npm run build",
    "postinstall": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-i18n": "^9.14.0",
    "vue-router": "^5.0.0",
    "vuex": "^4.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~6.0.0",
    "vite": "^8.2.1",
    "vue-tsc": "^3.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.59.2",
    "vue": "3.5.41",
    "vue-i18n": "^9.14.5",
    "vue-router": "^5.2.0",
    "vuex": "4.1.0"
  }
}
